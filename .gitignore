# vídeos, áudio e frames baixados das referências (direitos dos autores — não vão pro GitHub)
referencias/_brutos/
*.mp4
*.mov
*.wav
.DS_Store

# chaves de API (ElevenLabs etc.)
.env
.env.*
!.env.example

# artefatos de produção
saida/
producao/*/.hyperframes/
producao/*/node_modules/

# rosto e voz do dono (repo é público: nada que permita clonar)
producao/base-avatar/
producao/*/avatar/
producao/*/assets/avatar/
producao/*/assets/audio/narracao*.mp3
producao/*/amostras-voz/
# cópias de versões antigas das composições
producao/*/index-v*.html.txt

# python
__pycache__/
**/assets/avatar/
producao/*/capa/pv-*.png
producao/*/capa/capa-9x16.png
**/.hyperframes/
producao/*/capa/*.jpg
producao/*/capa/*.png
producao/*/assets/broll/

# A Virada: trilha e efeitos da Pixabay, fotos de arquivo e imagens geradas (não redistribuir no repo)
producao/a-virada-*/assets/audio/
producao/a-virada-*/capa/assets/img/

# trechos de terceiros recortados para o vídeo (falas, quadros de podcast, anúncio)
producao/*/assets/clipes/
# narração (voz do dono) em qualquer subpasta da produção
producao/**/narracao*.mp3
# fotos de banco/terceiros usadas nas capas
producao/*/capa/assets/img/

# testes do Codex (dublagem/rosto de terceiro): só locais
producao/gancho-qahtani/
producao/ia-com-precisao/
producao/ia-com-precisao-v2/

producao/dossie-01/assets/docs/
producao/dossie-*/assets/audio/
producao/dossie-*/capa/assets/img/

# dados locais do MCP do Instagram (métricas, nunca no git)
ferramentas/instagram-mcp/dados/
